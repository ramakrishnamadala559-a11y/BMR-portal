generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid())
  name        String
  email       String?      @unique
  phone       String       @unique
  password    String
  role        String
  status      String
  buildingId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  permissions Permission[]
}

model Permission {
  id        String   @id @default(uuid())
  userId    String
  module    String
  action    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module, action])
}

model Student {
  id               String      @id @default(uuid())
  name             String
  phone            String      @unique
  dob              String
  gender           String
  address          String
  emergencyContact String
  guardianName     String
  guardianPhone    String
  collegeOrCompany String
  courseOrDept     String
  idNumber         String
  idProofType      String
  idProofUrl       String?
  status           String
  admissionDate    DateTime    @default(now())
  expectedCheckout DateTime?
  securityDeposit  Float       @default(0)
  monthlyRent      Float       @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  admissions       Admission[]
  bed              Bed?
  documents        Document[]
  invoices         Invoice[]
  payments         Payment[]
}

model Building {
  id          String   @id @default(uuid())
  name        String   @unique
  wardenId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  description String?
  gender      String   @default("COLIVING")
  beds        Bed[]
  floors      Floor[]
  rooms       Room[]
}

model Floor {
  id         String   @id @default(uuid())
  number     Int
  buildingId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms      Room[]

  @@unique([buildingId, number])
}

model Room {
  id         String   @id @default(uuid())
  number     String
  type       String
  capacity   Int
  rent       Float
  status     String
  facilities String?
  floorId    String
  buildingId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  beds       Bed[]
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floor      Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@unique([buildingId, number])
}

model Bed {
  id         String   @id @default(uuid())
  name       String
  status     String
  roomId     String
  buildingId String
  studentId  String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  student    Student? @relation(fields: [studentId], references: [id])

  @@unique([roomId, name])
}

model Admission {
  id              String    @id @default(uuid())
  studentId       String
  bedId           String
  bedName         String
  roomNumber      String
  buildingName    String
  floorNumber     Int
  rentAtAdmission Float
  joiningDate     DateTime  @default(now())
  checkoutDate    DateTime?
  status          String
  createdAt       DateTime  @default(now())
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                 String    @id @default(uuid())
  invoiceNumber      String    @unique
  studentId          String
  studentName        String
  roomNumber         String
  bedName            String
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  dueDate            DateTime
  subtotal           Float
  lateFee            Float     @default(0)
  discount           Float     @default(0)
  total              Float
  paidAmount         Float     @default(0)
  balance            Float
  status             String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  arrears            Float     @default(0)
  student            Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments           Payment[]
}

model Payment {
  id         String   @id @default(uuid())
  paymentId  String   @unique
  studentId  String
  invoiceId  String?
  amount     Float
  date       DateTime @default(now())
  method     String
  notes      String?
  recordedBy String
  createdAt  DateTime @default(now())
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(uuid())
  amount      Float
  category    String
  buildingId  String?
  date        DateTime
  description String
  receiptUrl  String?
  addedBy     String
  createdAt   DateTime @default(now())
}

model Document {
  id        String   @id @default(uuid())
  studentId String
  type      String
  name      String
  fileUrl   String
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  recipient String
  type      String
  title     String
  message   String
  status    String
  createdAt DateTime @default(now())
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  targetGroup String
  date        DateTime @default(now())
  createdBy   String
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  userName    String
  action      String
  module      String
  description String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model HostelSettings {
  id                 String   @id @default("GLOBAL")
  hostelName         String   @default("Premium Stay Hostel")
  logoUrl            String?
  address            String   @default("123 Luxury Road, Silicon Valley")
  phone              String   @default("+1234567890")
  email              String   @default("contact@premiumhostel.com")
  website            String?  @default("www.premiumhostel.com")
  gstNumber          String?
  defaultRent        Float    @default(5000)
  defaultDueDateDay  Int      @default(5)
  defaultLateFee     Float    @default(200)
  invoicePrefix      String   @default("INV-")
  emailEnabled       Boolean  @default(true)
  smsEnabled         Boolean  @default(false)
  whatsappEnabled    Boolean  @default(true)
  showContactOnLogin Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
